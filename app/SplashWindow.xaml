<Window x:Class="DshDesktop.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        IsHitTestVisible="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen">
    <Grid Width="264" Height="264">
        <Ellipse x:Name="Glow" Width="200" Height="200">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#2EFFFFFF" Offset="0.0"/>
                    <GradientStop Color="#14FFFFFF" Offset="0.35"/>
                    <GradientStop Color="#07FFFFFF" Offset="0.7"/>
                    <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Effect>
                <BlurEffect Radius="16"/>
            </Ellipse.Effect>
        </Ellipse>
        <Image x:Name="Logo"
               Source="pack://application:,,,/dsh-icon.png"
               Width="160" Height="160"
               RenderOptions.BitmapScalingMode="HighQuality"/>
    </Grid>
</Window>
