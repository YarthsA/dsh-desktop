<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>DshDesktop</AssemblyName>
    <RootNamespace>DshDesktop</RootNamespace>
    <Version>0.1.0</Version>
    <ApplicationIcon>..\dsh-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="dsh-icon.png" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\dsh-icon.ico" CopyToOutputDirectory="PreserveNewest" Link="dsh-icon.ico" />
    <None Include="..\scripts\run-dsh-web.cmd" CopyToOutputDirectory="PreserveNewest" Link="scripts\run-dsh-web.cmd" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
  </ItemGroup>

</Project>
